# Bearer token from an authenticated Schulmanager session.
# Do not commit the real value.
SCHULMANAGER_TOKEN=

# Optional. The script normally discovers a directly associated student or the
# first child of a parent account. Set an ID to choose a specific child or when
# automatic discovery fails.
SCHULMANAGER_STUDENT_ID=

# Optional. Override only if automatic discovery fails.
SCHULMANAGER_BUNDLE_VERSION=

# Defaults are shown here for clarity.
SCHULMANAGER_BASE_URL=https://login.schulmanager-online.de
SCHULMANAGER_TIMEZONE=Europe/Berlin

# Server/container settings.
HOST_PORT=8080
PORT=8080
DATA_DIR=/data
SYNC_INTERVAL_MINUTES=30
SYNC_PAST_WEEKS=2
SYNC_FUTURE_WEEKS=2
SYNC_INCLUDE_CANCELLED=false
SYNC_NO_MERGE_ADJACENT=false

# Optional direct Google Calendar API sync.
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/data/google-service-account.json
# Optional alternative to the mounted file above. Inline JSON is easier to
# expose through process or container inspection, so prefer the file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional. Customize the calendar event title. Placeholders: {summary},
# {location}, {subject}, {subjectName}, {icon}, {teachers}, {classHour}. Empty
# placeholders left inside () are dropped automatically.
# Default: "({location}) {icon} {summary}"
GOOGLE_CALENDAR_TITLE_TEMPLATE=

# Optional. Renders the title of cancelled lessons with a Unicode
# strikethrough overlay instead of plain text. Cosmetic only; the Calendar
# API has no real text formatting, and rendering may vary by client.
GOOGLE_CALENDAR_STRIKETHROUGH_CANCELLED=false

# Optional. Path to the subject-to-emoji mapping used for {icon}. Created
# automatically from built-in defaults on first run; edit the file afterwards
# to add or change entries. Default: ${DATA_DIR}/subject-icons.json
GOOGLE_CALENDAR_SUBJECT_ICONS_FILE=

# Used only by docker-compose.ghcr.yml. Pin a release for predictable deployments.
SCHULMANAGER_IMAGE=ghcr.io/egore4606/schulmanager-calendar-sync:latest
